{
  "name": "trocaticket-event-planning-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --env-file-if-exists=local.env --test --test-concurrency=1 --test-global-setup=tests/global_setup.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:local": "node --env-file-if-exists=local.env scripts/setup_local.js",
    "token": "node --env-file-if-exists=local.env scripts/generate_token.js"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^7.1.1",
    "@grpc/grpc-js": "^1.14.6",
    "ajv": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
