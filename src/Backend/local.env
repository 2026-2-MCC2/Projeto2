# Variáveis de ambiente do ambiente local.
# Usadas pela API dentro do Docker (env_file no docker-compose.yml) e pelos testes (npm test).
# Em produção, essas variáveis são definidas no deploy (.github/workflows/backend.yml, na raiz do repositório).
# O que cada uma faz está explicado em src/constants.js.
# Este arquivo não tem nada sensível; senhas e chaves ficam no Secret Manager.

APP_ENV=local
SERVICE_NAME=trocaticket-event-planning-api
GCP_PROJECT_ID=local-project

DB_NAME=event_planning
DB_CREDENTIALS_SECRET_NAME=db_credentials
JWT_SECRET_NAME=jwt_secret

# endereço do front-end rodando com "npm run dev" (Vite)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# endereço do emulador visto da sua máquina (os testes usam este);
# dentro do Docker a API usa secret-manager:9090 (definido no docker-compose.yml)
SECRET_MANAGER_EMULATOR_HOST=localhost:9090
