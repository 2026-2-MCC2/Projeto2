{
  "title": "PostEvents",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150,
      "pattern": "\\S"
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "\\S"
    },
    "description": {
      "type": ["string", "null"],
      "maxLength": 2000
    },
    "start_date": {
      "type": "string"
    },
    "end_date": {
      "type": "string"
    },
    "venue_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150,
      "pattern": "\\S"
    },
    "address": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "city": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "state": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2,
      "pattern": "^[A-Za-z]{2}$"
    },
    "zip_code": {
      "type": ["string", "null"],
      "maxLength": 10
    },
    "venue_capacity": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "min_audience": {
      "type": "integer",
      "minimum": 1
    },
    "expected_audience": {
      "type": "integer",
      "minimum": 1
    },
    "max_audience": {
      "type": "integer",
      "minimum": 1
    },
    "profit_margin": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.9999
    },
    "reference_scenario": {
      "type": "string",
      "enum": ["minimum", "expected", "maximum"]
    },
    "status": {
      "type": "string",
      "enum": ["draft", "open_for_quotes"]
    },
    "internal_costs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["tax", "operational", "other"]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "\\S"
          },
          "amount": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": ["type", "description", "amount"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "category",
    "start_date",
    "end_date",
    "venue_name",
    "address",
    "city",
    "state",
    "min_audience",
    "expected_audience",
    "max_audience",
    "profit_margin"
  ],
  "additionalProperties": false
}
