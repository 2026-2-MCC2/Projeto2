{
  "title": "PostEvents",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150,
      "pattern": "\\S"
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "\\S"
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "start_date": {
      "description": "Data e hora em ISO 8601, ex.: 2026-12-10T22:00:00.000Z.",
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d(\\.\\d{1,3})?)?(Z|[+-]\\d{2}:\\d{2})$"
    },
    "end_date": {
      "description": "Data e hora em ISO 8601, ex.: 2026-12-10T22:00:00.000Z.",
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d(\\.\\d{1,3})?)?(Z|[+-]\\d{2}:\\d{2})$"
    },
    "venue_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150,
      "pattern": "\\S"
    },
    "address": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "city": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "state": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2,
      "pattern": "^[A-Za-z]{2}$"
    },
    "zip_code": {
      "description": "CEP com ou sem hífen: 01310-100 ou 01310100.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\s*\\d{5}-?\\d{3}\\s*$"
    },
    "venue_capacity": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "min_audience": {
      "type": "integer",
      "minimum": 1
    },
    "expected_audience": {
      "type": "integer",
      "minimum": 1
    },
    "max_audience": {
      "type": "integer",
      "minimum": 1
    },
    "profit_margin": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.9999
    },
    "reference_scenario": {
      "type": "string",
      "enum": [
        "minimum",
        "expected",
        "maximum"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "open_for_quotes"
      ]
    },
    "internal_costs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "tax",
              "operational",
              "other"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "\\S"
          },
          "amount": {
            "type": "number",
            "minimum": 0,
            "maximum": 9999999999.99
          }
        },
        "required": [
          "type",
          "description",
          "amount"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "category",
    "start_date",
    "end_date",
    "venue_name",
    "address",
    "city",
    "state",
    "min_audience",
    "expected_audience",
    "max_audience",
    "profit_margin"
  ],
  "additionalProperties": false
}
