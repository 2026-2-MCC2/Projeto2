{
  "title": "PostSupplierProposal",
  "description": "Proposta de um fornecedor para um item de custo. Os tamanhos seguem as colunas da tabela proposal; os campos TEXT (description, notes) cabem até 65.535 bytes, por isso o limite de 16.383 caracteres (4 bytes por caractere em utf8mb4).",
  "type": "object",
  "properties": {
    "amount": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 9999999999.99
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16383,
      "pattern": "\\S"
    },
    "not_included": {
      "type": "string",
      "maxLength": 500
    },
    "delivery_terms": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "payment_terms": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "team": {
      "type": "string",
      "maxLength": 255
    },
    "warranty": {
      "type": "string",
      "maxLength": 255
    },
    "valid_until": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "notes": {
      "type": "string",
      "maxLength": 16383
    }
  },
  "required": ["amount", "description", "delivery_terms", "payment_terms", "valid_until"],
  "additionalProperties": false
}
