{
  "title": "PostAuthCadastro",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "enum": ["organizador", "fornecedor"]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "email": {
      "type": "string",
      "maxLength": 150,
      "pattern": "^\\s*[^\\s@]+@[^\\s@]+\\.[^\\s@]+\\s*$"
    },
    "password": {
      "type": "string",
      "minLength": 8,
      "maxLength": 72
    },
    "cnpj": {
      "type": "string",
      "minLength": 14,
      "maxLength": 18
    },
    "phone": {
      "type": "string",
      "minLength": 10,
      "maxLength": 20
    },
    "service_area": {
      "description": "Área de atuação do fornecedor: as mesmas categorias da tabela item_category.",
      "type": "string",
      "enum": ["Estrutura", "Alimentação", "Segurança", "Outros"]
    }
  },
  "required": ["profile", "name", "email", "password", "cnpj", "phone"],
  "additionalProperties": false,
  "if": {
    "properties": { "profile": { "const": "fornecedor" } }
  },
  "then": {
    "required": ["service_area"]
  },
  "else": {
    "properties": { "service_area": { "not": {} } }
  }
}
