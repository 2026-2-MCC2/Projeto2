{
  "title": "PostAuthCadastro",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "enum": [
        "organizador",
        "fornecedor"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150,
      "pattern": "\\S"
    },
    "email": {
      "type": "string",
      "maxLength": 150,
      "pattern": "^\\s*[^\\s@]+@[^\\s@]+\\.[^\\s@]+\\s*$"
    },
    "password": {
      "type": "string",
      "minLength": 8,
      "maxLength": 72
    },
    "cnpj": {
      "type": "string",
      "minLength": 14,
      "maxLength": 32,
      "description": "Com ou sem pontuação, numérico (11.222.333/0001-81) ou alfanumérico (12.ABC.345/01DE-35).",
      "pattern": "^\\s*[A-Za-z0-9]{2}\\.?[A-Za-z0-9]{3}\\.?[A-Za-z0-9]{3}/?[A-Za-z0-9]{4}-?\\d{2}\\s*$"
    },
    "phone": {
      "type": "string",
      "minLength": 10,
      "maxLength": 20,
      "pattern": "^[\\d\\s()+-]+$"
    },
    "categories": {
      "description": "Categorias em que o fornecedor atua: os nomes da tabela item_category.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "Alimentação",
          "Bebidas",
          "Comunicação",
          "Decoração",
          "Equipe",
          "Estrutura",
          "Logística",
          "Segurança",
          "Tecnologia",
          "Outros"
        ]
      }
    }
  },
  "required": [
    "profile",
    "name",
    "email",
    "password",
    "cnpj",
    "phone"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "profile": {
        "const": "fornecedor"
      }
    }
  },
  "then": {
    "required": [
      "categories"
    ]
  },
  "else": {
    "properties": {
      "categories": {
        "not": {}
      }
    }
  }
}
